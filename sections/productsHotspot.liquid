                "min": 16,
                "max": 64,
                "unit": "px",
                "default": 30,
                "step": 2
            },
            {
                "type": "header",
                "content": "Section Color"
            },
            {
                "type": "color",
                "id": "sectionBackgroundColor",
                "label": "Section Background Color",
                "default": "#FFFFFF"
            },
            {
                "type": "color",
                "id": "sectionHeadingTextColor",
                "label": "Section Heading Text Color",
