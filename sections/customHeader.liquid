<style>
    .customHeader {
        background: {{ section.settings.headerBackgroundColor }};
        padding: 10px 15px;
    }
    .customHeader .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1200px;
        margin: 0 auto;
        gap: 20px;
    }

    /* Logo */
    .customHeader .logo img {
        max-height: 40px;
    }

    /* Center text */
    .customHeader .headerText {
        text-align: center;
        font-size: 16px;
        font-weight: 500;
        color: {{ section.settings.textColor }};
        flex: 1;
    }

    /* Button */
    .customHeader .headerButton {
        background: {{ section.settings.buttonBackgroundColor }};
        padding: 10px 20px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        color: #000;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: none;
        cursor: pointer;
        transition: background 0.3s ease, color 0.3s ease;
    }
    .customHeader .headerButton:hover {
        background: black;
        color: white;
    }
    .customHeader .headerButton svg {
        width: 18px;
        height: 12px;
    }

    /* Mobile */
    @media (max-width: 820px) {
        .customHeader .container {
            flex-direction: column;
            align-items: center;
            overflow: hidden;
            max-height: 0;
            transition: max-height 0.4s ease;
        }
        .customHeader.menu-opened .container {
            max-height: 400px; /* large enough */
        }
        .customHeader .headerText,
        .customHeader .headerButton {
            opacity: 0;
            transform: translateY(-10px);
            transition: opacity 0.3s ease, transform 0.3s ease;
        }
        .customHeader.menu-opened .headerText,
        .customHeader.menu-opened .headerButton {
            opacity: 1;
            transform: translateY(0);
        }
        .customHeader .mobileMenuToggle {
            display: flex;
            justify-content: space-between;
            width: 100%;
        }
        .customHeader #menu-close {
            display: none;
        }
        .customHeader.menu-opened #menu-open {
            display: none;
        }
        .customHeader.menu-opened #menu-close {
            display: inline-block;
        }
    }
</style>

<header class="customHeader">
    <div class="mobileMenuToggle">
        <button id="menu-open" class="menuButton">☰</button>
        <button id="menu-close" class="menuButton">✕</button>
    </div>
    <div class="container">
        <!-- Left: Logo -->
        <div class="logo">
            {% if section.settings.logo != blank %}
                <a href="/" title="Home">
                    <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="Logo">
                </a>
            {% else %}
                <span style="font-weight:700;">{{ shop.name }}</span>
            {% endif %}
        </div>

        <!-- Center: Text -->
        <div class="headerText">
            {{ section.settings.centerText }}
        </div>

        <!-- Right: Button -->
        {% if section.settings.buttonText != blank %}
            <a href="{{ section.settings.buttonLink }}" class="headerButton">
                {{ section.settings.buttonText }}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </a>
        {% endif %}
    </div>
</header>

<script>
    const header = document.querySelector('.customHeader');
    const container = header.querySelector('.container');
    const openBtn = document.getElementById('menu-open');
    const closeBtn = document.getElementById('menu-close');

    openBtn?.addEventListener('click', () => {
        header.classList.add('menu-opened');
        container.style.maxHeight = container.scrollHeight + "px";
    });

    closeBtn?.addEventListener('click', () => {
        header.classList.remove('menu-opened');
        container.style.maxHeight = "0px";
    });

    // Fix on resize
    window.addEventListener('resize', () => {
        if (window.innerWidth > 820) {
            container.style.maxHeight = "none";
        } else if (!header.classList.contains('menu-opened')) {
            container.style.maxHeight = "0px";
        }
    });
</script>


{% schema %}
    {
        "name": "Header",
        "settings": [
            {
                "type": "header",
                "content": "Header Content"
            },
            {
                "type": "image_picker",
                "id": "logo",
                "label": "Logo"
            },
            {
                "type": "text",
                "id": "centerText",
                "label": "Center Text",
                "default": "Find the ideal gift for your loved ones."
            },
            {
                "type": "text",
                "id": "buttonText",
                "label": "Button Text",
                "default": "choose gift"
            },
            {
                "type": "url",
                "id": "buttonLink",
                "label": "Button Link",
            },
            {
                "type": "header",
                "content": "Colors For Header Content"
            },
            {
                "type": "color",
                "id": "headerBackgroundColor",
                "label": "Header Background Color",
                "default": "#F5F5F5"
            },
            {
                "type": "color",
                "id": "textColor",
                "label": "Text Color",
                "default": "#000000"
            },
            {
                "type": "color",
                "id": "buttonBackgroundColor",
                "label": "Button Background Color",
                "default": "#FFF544"
            },
            {
                "type": "range",
                "id": "headerTopPadding",
                "min": 0,
                "max": 32,
                "unit": "px",
                "label": "Header Top Padding",
                "default": 10
            },
            {
                "type": "range",
                "id": "headerBottomPadding",
                "min": 0,
                "max": 32,
                "unit": "px",
                "label": "Header Bottom Padding",
                "default": 10
            }
        ],
        "presets": [
            {
                "name": "Header"
            }
        ]
    }
{% endschema %}