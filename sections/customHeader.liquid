<style>
    .customHeader {
        background: white;
        border-bottom: 1px solid #ddd;
        padding: 10px 15px;
    }

    /* --- Desktop Layout --- */
    .customHeader .desktopContainer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1200px;
        margin: 0 auto;
        gap: 20px;
    }

    .customHeader .logo img {
        max-height: 40px;
    }

    .customHeader .headerText {
        text-align: center;
        font-size: 16px;
        color: #111;
        flex: 1;
    }

    .customHeader .headerButton {
        background: #ffe800; /* yellow button */
        padding: 12px 22px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        color: #000;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        cursor: pointer;
        transition: background 0.3s ease;
    }
    .customHeader .headerButton:hover {
        background: #000;
        color: #fff;
    }
    .customHeader .headerButton svg {
        width: 18px;
        height: 12px;
    }

    /* --- Mobile Layout --- */
    .customHeader .mobileTopbar {
        display: none;
    }

    @media (max-width: 820px) {
        .customHeader .desktopContainer {
            display: none;
        }

        /* Top bar */
        .customHeader .mobileTopbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .customHeader .mobileTopbar .logo {
            font-size: 18px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .customHeader .menuButton {
            background: none;
            border: none;
            font-size: 22px;
            cursor: pointer;
        }

        /* Dropdown Panel */
        .customHeader .mobileMenu {
            overflow: hidden;
            max-height: 0;
            transition: max-height 0.4s ease;
            text-align: center;
        }
        .customHeader.menu-opened .mobileMenu {
            max-height: 400px; /* enough to show all */
        }

        .customHeader .mobileMenu .logo {
            font-weight: 700;
            margin: 15px 0;
            font-size: 18px;
        }

        .customHeader .mobileMenu .headerText {
            margin: 10px 0;
            font-size: 15px;
            color: #444;
        }

        .customHeader .mobileMenu .headerButton {
            margin: 15px auto;
        }

        /* Hide/Show toggle icons */
        #menu-close { display: none; }
        .customHeader.menu-opened #menu-open { display: none; }
        .customHeader.menu-opened #menu-close { display: inline-block; }
    }
</style>

<header class="customHeader">
    <!-- Mobile Top Bar -->
    <div class="mobileTopbar">
        <button id="menu-open" class="menuButton">☰</button>
        <div class="logo">
            {% if section.settings.logo != blank %}
                <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="Logo">
            {% else %}
                {{ shop.name }}
            {% endif %}
        </div>
        <button id="menu-close" class="menuButton">✕</button>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div class="mobileMenu">
        <div class="logo">
            {% if section.settings.logo != blank %}
                <img src="{{ section.settings.logo | image_url: width: 160 }}" alt="Logo">
            {% else %}
                {{ shop.name }}
            {% endif %}
        </div>
        <div class="headerText">{{ section.settings.centerText }}</div>
        {% if section.settings.buttonText != blank %}
            <a href="{{ section.settings.buttonLink }}" class="headerButton">
                {{ section.settings.buttonText }}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </a>
        {% endif %}
    </div>

    <!-- Desktop Header -->
    <div class="desktopContainer">
        <div class="logo">
            {% if section.settings.logo != blank %}
                <a href="/"><img src="{{ section.settings.logo | image_url: width: 200 }}" alt="Logo"></a>
            {% else %}
                {{ shop.name }}
            {% endif %}
        </div>
        <div class="headerText">{{ section.settings.centerText }}</div>
        {% if section.settings.buttonText != blank %}
            <a href="{{ section.settings.buttonLink }}" class="headerButton">
                {{ section.settings.buttonText }}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </a>
        {% endif %}
    </div>
</header>

<script>
    const header = document.querySelector('.customHeader');
    const menu = header.querySelector('.mobileMenu');
    const openBtn = document.getElementById('menu-open');
    const closeBtn = document.getElementById('menu-close');

    function openMenu() {
        header.classList.add('menu-opened');
        menu.style.maxHeight = menu.scrollHeight + "px";
    }

    function closeMenu() {
        header.classList.remove('menu-opened');
        menu.style.maxHeight = "0px";
    }

    openBtn?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);

    window.addEventListener('resize', () => {
        if (window.innerWidth > 820) {
            menu.style.maxHeight = "none";
        } else if (!header.classList.contains('menu-opened')) {
            menu.style.maxHeight = "0px";
        }
    });
</script>


{% schema %}
    {
        "name": "Header",
        "settings": [
            {
                "type": "header",
                "content": "Header Content"
            },
            {
                "type": "image_picker",
                "id": "logo",
                "label": "Logo"
            },
            {
                "type": "text",
                "id": "centerText",
                "label": "Center Text",
                "default": "Find the ideal gift for your loved ones."
            },
            {
                "type": "text",
                "id": "buttonText",
                "label": "Button Text",
                "default": "choose gift"
            },
            {
                "type": "url",
                "id": "buttonLink",
                "label": "Button Link",
            },
            {
                "type": "header",
                "content": "Colors For Header Content"
            },
            {
                "type": "color",
                "id": "headerBackgroundColor",
                "label": "Header Background Color",
                "default": "#F5F5F5"
            },
            {
                "type": "color",
                "id": "textColor",
                "label": "Text Color",
                "default": "#000000"
            },
            {
                "type": "color",
                "id": "buttonBackgroundColor",
                "label": "Button Background Color",
                "default": "#FFF544"
            },
            {
                "type": "range",
                "id": "headerTopPadding",
                "min": 0,
                "max": 32,
                "unit": "px",
                "label": "Header Top Padding",
                "default": 10
            },
            {
                "type": "range",
                "id": "headerBottomPadding",
                "min": 0,
                "max": 32,
                "unit": "px",
                "label": "Header Bottom Padding",
                "default": 10
            }
        ],
        "presets": [
            {
                "name": "Header"
            }
        ]
    }
{% endschema %}