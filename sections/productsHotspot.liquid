{% schema %}
    {
        "name": "Products Hotspot",
        "settings": [
            {
                "type": "header",
                "content": "Section Heading"
            },
            {
                "type": "text",
                "id": "sectionHeading",
                "label": "Section Heading",
                "default": "Tisso vison in the wild"
            },
            {
                "type": "range",
                "id": "headingSizeDesktop",
